<?xml version="1.0" encoding="utf-8"?>
<!-- "오늘 한눈에" 위젯: 위는 날씨·미세먼지, 아래는 줄마다 하나씩(장바구니·청약·행사). 줄은 남는 높이를 나눠 가짐 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/weather_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/w_region"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="서울 · 10월 18일 일요일"
            android:textColor="@color/widget_soft"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="21°"
                android:textColor="@color/widget_ink"
                android:textSize="42sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_cond"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="맑음"
                    android:textColor="@color/widget_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="14° / 23°"
                    android:textColor="@color/widget_soft"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_pm10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="미세먼지 좋음"
                    android:textColor="@color/widget_soft"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/w_pm25"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="초미세먼지 보통"
                    android:textColor="@color/widget_soft"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_line" />

    <LinearLayout
        android:id="@+id/basket_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="●"
            android:textColor="@color/sec_market"
            android:textSize="8sp" />

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="장바구니"
            android:textColor="@color/widget_soft"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/basket_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="지난주보다 5.4% 내렸어요"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/housing_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_line" />

    <LinearLayout
        android:id="@+id/housing_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="●"
            android:textColor="@color/sec_money"
            android:textSize="8sp" />

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="주거"
            android:textColor="@color/widget_soft"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/housing_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="공공임대 7건 · 청약 0건"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/culture_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_line" />

    <LinearLayout
        android:id="@+id/culture_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="●"
            android:textColor="@color/sec_culture"
            android:textSize="8sp" />

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="행사"
            android:textColor="@color/widget_soft"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/culture_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="이번 주 행사 49개 열려요"
            android:textColor="@color/widget_ink"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
