# 이 파일을 backend/.env로 복사해서 값을 채우세요. (.env와 *.db는 git에 안 올라감)
# 실제 키·주소는 공공데이터포털 마이페이지 활용신청 현황에서 확인.
#
# 포털 인증키 — 계정당 하나로 승인된 API 전부에 씀. 코드는 DECODED를 requests params로 넘김
# (ENCODED는 URL에 직접 붙일 때만. 둘을 바꿔 쓰면 SERVICE_KEY_IS_NOT_REGISTERED_ERROR)
DATA_GO_KR_SERVICE_KEY_ENCODED=
DATA_GO_KR_SERVICE_KEY_DECODED=

# 수집기가 쓰는 주소들 (값은 승인된 API 명세의 요청 주소)
KMA_SHORT_FCST_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
KMA_MID_FCST_BASE_URL=https://apis.data.go.kr/1360000/MidFcstInfoService
AIRKOREA_AIR_QUALITY_BASE_URL=https://apis.data.go.kr/B552584/ArpltnInforInqireSvc
AIRKOREA_STATION_BASE_URL=https://apis.data.go.kr/B552584/MsrstnInfoInqireSvc
KASI_SPECIAL_DAY_BASE_URL=https://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService
KASI_RISE_SET_BASE_URL=https://apis.data.go.kr/B090041/openapi/service/RiseSetInfoService
KMA_LIVING_IDX_BASE_URL=https://apis.data.go.kr/1360000/LivingWthrIdxServiceV5
KMA_POLLEN_BASE_URL=https://apis.data.go.kr/1360000/HealthWthrIdxServiceV3
KMA_WARNING_BASE_URL=https://apis.data.go.kr/1360000/WthrWrnInfoService
AT_PRICE_RECENT_BASE_URL=https://apis.data.go.kr/B552845/recent
EKAPE_LIVESTOCK_BASE_URL=http://data.ekape.or.kr/openapi-data/service/user
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=Dailycut
KCISA_CULTURE_BASE_URL=https://apis.data.go.kr/B553457/cultureinfo
APPLYHOME_BASE_URL=https://api.odcloud.kr/api/ApplyhomeInfoDetailSvc/v1
MYHOME_NOTICE_BASE_URL=https://apis.data.go.kr/1613000/HWSPR02
GOV24_BENEFIT_BASE_URL=https://api.odcloud.kr/api/gov24/v3
# 선택(없어도 됨): 지진 정보(KMA_EARTHQUAKE_BASE_URL — 없으면 지진 줄이 빠짐), 영양성분 데이터 생성용 MFDS_FOOD_NUTRITION_BASE_URL(코드에 기본값 있음)

# 2026-11-08: 위 목록이 코드가 읽는 주소 전부 — 빠지면 그 소스 작업이 조용히 건너뛰어지고 스텁이 나감.
# 광고(상업 이용) 때문에 뺀 소스(금융위 지수·상품 FSC_*, 금감원 FINLIFE_API_KEY, KOBIS_KEY, KOSIS)는 일부러 적지 않음 — docs/licensing.md. 허락 없이 되살리지 말 것.
# 지역화폐(한국조폐공사) 4종은 DATA_GO_KR_SERVICE_KEY_DECODED만 쓰고 주소는 코드에 있음.
